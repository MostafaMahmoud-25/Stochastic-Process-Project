    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "# R6: Define hidden states, observations, initial distribution, and emission matrix\n",
    "STATES = [\"Focused\", \"Distracted\", \"Burned Out\"]\n",
    "OBSERVATIONS = [\"High Score\", \"Average Score\", \"Low / Missed\"]\n",
    "\n",
    "obs_to_idx = {obs: idx for idx, obs in enumerate(OBSERVATIONS)}\n",
    "\n",
    "pi_0 = np.array([0.50, 0.30, 0.20])\n",
    "\n",
    "# Ensure P is available from earlier cells; fallback definition if running cell standalone\n",
    "if \"P\" not in globals():\n",
    "    P = np.array([\n",
    "        [0.70, 0.20, 0.10],\n",
    "        [0.30, 0.50, 0.20],\n",
    "        [0.20, 0.35, 0.45]\n",
    "    ])\n",
    "\n",
    "E = np.array([\n",
    "    [0.70, 0.20, 0.10],\n",
    "    [0.25, 0.45, 0.30],\n",
    "    [0.10, 0.25, 0.65]\n",
    "])\n",
    "\n",
    "assert np.isclose(pi_0.sum(), 1.0), \"pi_0 must sum to 1.\"\n",
    "assert np.allclose(P.sum(axis=1), 1.0), \"Each row of P must sum to 1.\"\n",
    "assert np.allclose(E.sum(axis=1), 1.0), \"Each row of E must sum to 1.\"\n",
    "E_df = pd.DataFrame(E, index=STATES, columns=OBSERVATIONS)\n",
    "print(\"Emission Matrix E:\")\n",
    "display(E_df)"
