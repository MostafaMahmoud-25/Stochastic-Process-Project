    "# R7: Forward Algorithm\n",
    "def forward_algorithm(obs_seq, pi_init, trans_mat, emit_mat):\n",
    "    obs_indices = [obs_to_idx[o] for o in obs_seq]\n",
    "    T_len = len(obs_indices)\n",
    "    N_states = len(pi_init)\n",
    "\n",
    "    alpha = np.zeros((T_len, N_states))\n",
    "\n",
    "    # Initialization (t = 0)\n",
    "    alpha[0] = pi_init * emit_mat[:, obs_indices[0]]\n",
    "\n",
    "    # Induction (t = 1 to T_len - 1)\n",
    "    for t in range(1, T_len):\n",
    "        for j in range(N_states):\n",
    "            alpha[t, j] = np.sum(alpha[t - 1] * trans_mat[:, j]) * emit_mat[j, obs_indices[t]]\n",
    "\n",
    "    # Termination: total probability of the observation sequence\n",
    "    prob_obs = np.sum(alpha[-1])\n",
    "    return prob_obs, alpha\n",
    "\n",
    "sample_obs = [\"High Score\", \"Average Score\", \"Low / Missed\", \"Low / Missed\"]\n",
    "seq_prob, alpha_table = forward_algorithm(sample_obs, pi_0, P, E)\n",
    "\n",
    "alpha_df = pd.DataFrame(\n",
    "    alpha_table,\n",
    "    index=[f\"t={i} ({obs})\" for i, obs in enumerate(sample_obs)],\n",
    "    columns=STATES\n",
    ")\n",
    "\n",
    "print(\"Forward variables (alpha):\")\n",
    "display(alpha_df)\n",
    "print(f\"P(Observation Sequence) = {seq_prob:.6f}\")"
   ]
